# ===========================================================================
# Backend configuration — copy to `.env` and fill in.
#
# Every variable the backend reads is listed here, and they ALL use the APP_
# prefix. Real environment variables (Docker / production) take precedence over
# this file.
# ===========================================================================

# --- Core ---------------------------------------------------------------
# Deployment environment: "development", "staging", or "production".
# Outside "development" the app refuses to boot on the default APP_SECRET_KEY,
# and the local email/password dev login stays disabled.
APP_ENVIRONMENT=development

# Display name of this install (shown as the API title). Optional; has a default.
APP_APP_NAME=Project Management

# Public URLs. The Google OAuth redirect URL is DERIVED from APP_BACKEND_BASE_URL
# (`<backend>/auth/google/callback`) — there is no separate redirect-URI variable.
APP_FRONTEND_BASE_URL=http://localhost:3000
APP_BACKEND_BASE_URL=http://localhost:8000

# --- Security / sessions ------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=your-secret-key-here-change-in-production
APP_SESSION_COOKIE_NAME=app_session
# Idle window; the session slides forward on activity. 10080 = 7 days.
APP_SESSION_EXPIRY_MINUTES=10080
# How long (seconds) a user's role/active status is cached in-process before it is
# re-read from the DB. 0 = re-read on every request. Optional; default 60.
APP_ROLE_CACHE_TTL_SECONDS=60
# Encryption key for OAuth (Google) and Slack bot tokens stored in the database,
# so a DB/backup leak does not expose live credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several keys may be listed comma-separated to rotate (first encrypts, any
# decrypts). Empty = tokens stored in PLAINTEXT (a warning is logged); fine for
# local development, but set a real key before production. Losing this key means
# every user must reconnect Google and Slack, so back it up safely.
APP_TOKEN_ENCRYPTION_KEY=

# --- Database (MongoDB) -------------------------------------------------
APP_MONGODB_URI=mongodb://localhost:27017
APP_MONGODB_DB_NAME=project_management

# --- File storage -------------------------------------------------------
# Where uploaded attachments (ticket and lifecycle files) are kept.
# Empty (the default) stores them on local disk under APP_DATA_DIR. Set a
# cloud URL to use object storage instead:
#   s3://bucket/prefix   az://container/prefix   gs://bucket/prefix
# Install the matching extra first (pip install '.[s3]' / '.[azure]' / '.[gcs]'),
# then uncomment and fill in that provider's credentials below. These are the
# providers' own standard env vars (not APP_ settings) — never put a secret in
# the URL itself.
APP_STORAGE_URL=
#
# Amazon S3 (or any S3-compatible store). URL: s3://bucket/prefix
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
#
# Azure Blob Storage. URL: az://container/prefix
# AZURE_STORAGE_CONNECTION_STRING=
#
# Google Cloud Storage. URL: gs://bucket/prefix
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Local storage root, used only when APP_STORAGE_URL is empty. Empty (the
# default) is a `data/uploads` folder at the project root, outside the source
# tree. Under Docker this is set to /app/uploads (the mounted volume) for you.
APP_DATA_DIR=

# --- Google OAuth (sign-in + Workspace user sync) -----------------------
# Get these from https://console.cloud.google.com/
APP_GOOGLE_CLIENT_ID=your-google-client-id
APP_GOOGLE_CLIENT_SECRET=your-google-client-secret
# Comma-separated list of allowed email domains, e.g. "example.com,another.org".
# Empty = any Google account can sign in.
APP_ALLOWED_DOMAINS=
# Google Workspace primary domain, e.g. "example.com". Set only if you have a
# Workspace account and want directory user-sync. Empty (default) hides the sync
# screens and disables /google-sync; Google sign-in still works either way.
APP_GOOGLE_WORKSPACE_DOMAIN=

# --- Slack integration --------------------------------------------------
# Register an app at https://api.slack.com/apps
APP_SLACK_CLIENT_ID=your-slack-client-id
APP_SLACK_CLIENT_SECRET=your-slack-client-secret
APP_SLACK_SIGNING_SECRET=your-slack-signing-secret

# --- Local dev login (development only) ---------------------------------
# Enables email/password login when APP_ENVIRONMENT=development and the backend is
# on localhost (Google OAuth can't complete against localhost). Never set in prod.
APP_DEV_LOGIN_PASSWORD=

# --- Advanced / internal: service-to-service key (OFF by default) -------
# When set, a request carrying `X-API-Key: <this value>` and
# `X-On-Behalf-Of: <user-email>` is treated as that user — for internal automation
# and service accounts that act on a user's behalf without a browser session.
#
# DANGER: anyone who has this key can act as ANY existing user, including an admin,
# on every endpoint. It is a system-wide capability with no per-action scoping or
# audit trail. Leave it EMPTY to disable it (the default). Only ever set it on a
# trusted, network-restricted instance; never on a shared or public one. The
# on-behalf email is restricted to APP_ALLOWED_DOMAINS when that is set.
APP_SERVICE_KEY=

# --- First-run admin (used by scripts/setup.sh and scripts.init_db) -----
# Optional: lets first-run setup create the global admin non-interactively instead
# of prompting. Read only by the setup script, never by the running app — safe to
# leave unset once the admin exists.
# APP_INIT_ADMIN_EMAIL=
# APP_INIT_ADMIN_NAME=Administrator
# APP_INIT_ADMIN_PASSWORD=
